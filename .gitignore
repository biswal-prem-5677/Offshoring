# Claude Code transient state
# Note: .claude/settings.local.json IS tracked in this repo by choice.
# Worktrees stay ignored — they are nested git checkouts and cannot be committed.
.claude/worktrees/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Build / dependency output (for when implementation starts)
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
.next/
out/

# Local data, models and artefacts — never commit model weights or customer data
data/
models/
*.gguf
*.safetensors
*.bin
uploads/
logs/
*.log
