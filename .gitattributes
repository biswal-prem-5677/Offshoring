# Line-ending policy: normalise everything to LF in the repository and on
# checkout, on every platform. Prevents CRLF churn when this repo is cloned
# on Linux/macOS for a build.
* text=auto eol=lf

# Explicit for the file types this repo actually contains
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
Dockerfile     text eol=lf

# Windows-only scripts must keep CRLF or they break
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff, never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.gguf       binary
*.safetensors binary
*.bin        binary

# Treat docs as text for diffing but suppress them from language stats
docs/** linguist-documentation
